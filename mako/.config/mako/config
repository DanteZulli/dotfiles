# mako — Gruvbox Dark

font=JetBrainsMono Nerd Font Mono 12
background-color=#282828ff
text-color=#ebdbb2ff
border-color=#504945ff
border-size=2
border-radius=0
progress-color=over #689d6aff

width=380
height=160
outer-margin=8
margin=8
padding=12
icons=1
max-icon-size=32
default-timeout=5000
ignore-timeout=0
max-visible=5
sort=-time
layer=top
anchor=top-right
markup=1
actions=1
history=1
max-history=5
text-alignment=left

on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=dismiss

[urgency=low]
border-color=#665c54ff
text-color=#bdae93ff
default-timeout=3000

[urgency=normal]
border-color=#504945ff

[urgency=critical]
background-color=#3c3836ff
text-color=#fbf1c7ff
border-color=#fb4934ff
default-timeout=0
ignore-timeout=0

[hidden]
format=(%h más) <b>%s</b>\n%b
