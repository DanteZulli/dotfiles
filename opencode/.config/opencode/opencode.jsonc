{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/AGENTS.md", "AGENTS.md"],
  "lsp": true,
  "formatter": true,
  "permission": "allow",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--headless",
          "--user-data-dir",
          "/home/dante/.config/chromium-playwright",
          "--executable-path",
          "/usr/sbin/chromium"
        ],
        "disabled": true
      }
    }
  }
}
