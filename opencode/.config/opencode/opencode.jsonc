{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/AGENTS.md", "AGENTS.md"],
  "lsp": true,
  "formatter": true,
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*/git *",
      "effect": "ask"
    }
  ],
  "providers": {
    // Local GGUF models served by the llama.cpp router (systemd: llama-server.service).
    "local": {
      "name": "Local GGUF (llama.cpp)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        // IDs must match the preset sections in ~/.gguf/llama.ini.
        "ornith-1.5-9b": {
          "modelID": "ornith",
          "name": "Ornith 1.5 9B Q5_K_M (local, vision)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 8192,
            "output": 4096
          }
        },
        "qwen2.5.1-coder-7b": {
          "modelID": "qwen251-coder",
          "name": "Qwen2.5.1 Coder 7B Q5_K_M (local)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 8192,
            "output": 4096
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--headless",
          "--user-data-dir",
          "/home/dante/.config/chromium-playwright",
          "--executable-path",
          "/usr/sbin/chromium"
        ],
        "disabled": true
      }
    }
  }
}
