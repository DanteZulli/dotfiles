{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/AGENTS.md", "AGENTS.md"],
  "lsp": true,
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git ls-files*": "allow",
      "git ls-remote*": "allow",
      "git branch": "allow",
      "git branch --*": "allow",
      "git branch -a*": "allow",
      "git branch --list*": "allow",
      "git tag --list*": "allow",
      "git tag -l*": "allow",
      "git remote*": "allow",
      "git rev-parse*": "allow",
      "git rev-list*": "allow",
      "git config --get*": "allow",
      "git config --list*": "allow",
      "git fetch*": "allow",

      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git pull*": "ask",
      "git reset*": "ask",
      "git restore*": "ask",
      "git checkout*": "ask",
      "git switch*": "ask",
      "git merge*": "ask",
      "git rebase*": "ask",
      "git cherry-pick*": "ask",
      "git revert*": "ask",
      "git stash*": "ask",
      "git clean*": "ask",
      "git rm*": "ask",
      "git mv*": "ask",
      "git branch -d*": "ask",
      "git branch -D*": "ask",
      "git branch -m*": "ask",
      "git branch -M*": "ask",
      "git tag -d*": "ask",

      // 3b. otros comandos destructivos del sistema -> ask
      "rm *": "ask",
      "rm -rf*": "ask",
      "mv *": "ask",
      "cp *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "chgrp *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "shred *": "ask",

      // 4. escalada de privilegios -> deny (DEBE IR AL FINAL, última regla gana)
      "sudo": "deny",
      "sudo *": "deny",
      "*sudo*": "deny",
      "su": "deny",
      "su *": "deny",
      "*su -c*": "deny",
      "doas *": "deny",
      "*doas*": "deny",
      "pkexec *": "deny",
      "*pkexec*": "deny",
      "run0 *": "deny",
      "run0": "deny",
      "*run0*": "deny",
    },
  },
}
