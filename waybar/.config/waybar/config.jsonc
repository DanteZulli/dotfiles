{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "group/cpu-monitor",
    "group/gpu-monitor",
    "memory",
    "pulseaudio",
    "network",
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true,
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 50,
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "on-click": "xdg-terminal-exec wiremix",
    "tooltip-format": "{desc} — {volume}%",
  },
  "network": {
    "format-wifi": "  {essid} ({signalStrength}%)",
    "format-ethernet": "󰈀 {ipaddr}/{cidr}",
    "tooltip-format": "{ifname} via {gwaddr}",
    "format-linked": "󰈀 {ifname} (No IP)",
    "format-disconnected": "󰖪 Disconnected",
  },
  "group/cpu-monitor": {
    "orientation": "horizontal",
    "modules": ["cpu", "temperature#cpu"],
  },
  "group/gpu-monitor": {
    "orientation": "horizontal",
    "modules": ["custom/gpu", "temperature#gpu"],
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 2,
    "tooltip": true,
  },
  "temperature#cpu": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "format": "{temperatureC}°C",
    "tooltip-format": "AMD k10temp (Tctl): {temperatureC}°C",
    "interval": 2,
  },
  "custom/gpu": {
    "exec": "cat /sys/devices/pci0000:00/0000:00:01.1/0000:10:00.0/0000:11:00.0/0000:12:00.0/gpu_busy_percent 2>/dev/null",
    "format": "󰢮 {}%",
    "interval": 2,
    "tooltip": false,
  },
  "temperature#gpu": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:01.1/0000:10:00.0/0000:11:00.0/0000:12:00.0/hwmon",
    "input-filename": "temp1_input",
    "format": "{temperatureC}°C",
    "tooltip-format": "AMD amdgpu (edge): {temperatureC}°C",
    "interval": 2,
  },
  "memory": {
    "format": " {}%",
    "tooltip": true,
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%Y-%m-%d - %H:%M:%S}",
    "interval": 1,
  },
  "tray": {
    "spacing": 10,
  },
}
